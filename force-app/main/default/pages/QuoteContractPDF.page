<apex:page standardController="Quote" extensions="QuoteContractPDFController" renderAs="pdf" showHeader="false" sidebar="false" standardStylesheets="false" applyBodyTag="false" applyHtmlTag="false" cache="false">

    <html>

        <head>

            <style type="text/css">

                @page {

                    size: letter;

                    margin: 0;

                }

                @font-face { font-family:'Poppins'; src: url('{!$Resource.Poppins}/Poppins-Regular.ttf'); font-weight:normal; font-style:normal; }

                @font-face { font-family:'Poppins'; src: url('{!$Resource.Poppins}/Poppins-Bold.ttf');    font-weight:bold;   font-style:normal; }

                b, strong { font-family: 'Poppins', sans-serif; font-weight: bold; }

                body { font-family:'Poppins','Helvetica','Arial',sans-serif; font-size:10pt; color:#333; line-height:1.15; margin:0; padding:0; }

                

                .header-img   { width:100%; display:block; position:fixed; top:0; left:0; z-index:1000; }

                .footer-img   { width:100%; display:block; position:fixed; bottom:0; left:0; height:1.5cm; z-index:1000; }

                .watermark    { position:fixed; top:30%; width:100%; z-index:-1; }

                .tech-draft-mark { position:fixed; top:42%; left:0; width:100%; text-align:center; font-size:90pt; font-weight:bold; color:#ececec; letter-spacing:10pt; z-index:-1; }

                .page-counter { position:fixed; top:0.4cm; right:15pt; font-size:7.5pt; color:#fff; z-index:1001; }

                .pgNum:before   { content: counter(page); }

                .pgCount:before { content: counter(pages); }



                .content-body { padding:0 32pt; }



                .hdr-table      { width:100%; border-collapse:collapse; }

                .quote-number   { font-size:16pt; font-weight:bold; }

                .nombre-comercial { font-size:11pt; font-weight:bold; margin-top:4pt; }

                .asunto         { margin-top:4pt; font-size:10pt; }

                .sede-title     { font-size:13pt; font-weight:bold; margin-top:8pt; border-bottom:1pt solid #ddd; padding-bottom:4pt; }



                .intro-block     { margin-top:3pt; font-size:10pt; padding-left:10pt; padding-right:10pt; }

                .intro-block img { max-width:100% !important; height:auto !important; }



                .tbl-svc              { width:100%; table-layout:fixed; border-collapse:collapse; margin-top:4pt; -fs-table-paginate: paginate; }

                .tbl-svc th           { background-color:#0a315e; color:#ffffff; text-align:center; border-bottom:1.5pt solid #0070d2; padding:7pt 6pt; font-size:8pt; text-transform:uppercase; font-weight:bold; }

                .row-sep td           { background-color:#eef2f9; color:#0070d2; font-weight:bold; font-size:9.5pt; padding:8pt; border-top:2pt solid #0070d2; }

                .row-item td          { padding:7pt 6pt; font-size:10pt; border-bottom:0.5pt solid #f0f0f0; background-color:#fff; vertical-align:middle; }

                .row-detail td        { padding:3pt 32pt 10pt 16pt; border-bottom:0.5pt solid #eee; font-size:9pt; color:#444; line-height:1.15; overflow:hidden; word-wrap:break-word; }

                .detail-inner         { border-left:2pt solid #dde; padding-left:10pt; overflow:hidden; word-wrap:break-word; }

                .detail-inner b, .detail-inner strong { font-weight: bold; }

                .detail-inner i, .detail-inner em { font-style: italic; }

                .detail-inner u { text-decoration: underline; }

                .detail-inner p { margin: 2pt 0; }

                .detail-inner h1 { font-size: 16pt; font-weight: bold; margin-bottom: 4pt; }

                .detail-inner h2 { font-size: 13pt; font-weight: bold; margin-bottom: 3pt; }

                .detail-inner h3 { font-size: 11pt; font-weight: bold; margin-bottom: 2pt; }

                .detail-inner .ql-size-small { font-size: 7.5pt; }

                .detail-inner .ql-size-large { font-size: 11.5pt; }

                .detail-inner .ql-size-huge  { font-size: 14pt; }

                .detail-inner .ql-align-center { text-align: center; display: block; }

                .detail-inner .ql-align-right  { text-align: right; display: block; }

                .detail-inner .ql-align-justify { text-align: justify; display: block; }

                .detail-inner ul, .detail-inner ol { margin: 2pt 0 2pt 15pt; padding: 0; }

                .detail-inner img     { max-width:100% !important; height:auto !important; }



                .tbl-totals           { width:210pt; border-collapse:collapse; margin-left:auto; margin-top:14pt; }

                .tbl-totals td        { padding:4pt 6pt; font-size:9.5pt; }

                .tot-lbl              { font-weight:bold; color:#555; text-align:right; }

                .tot-val              { text-align:right; border-bottom:0.5pt solid #ddd; width:85pt; }

                .row-grand td         { border-top:1.5pt solid #0070d2; padding-top:8pt; }

                .row-grand .tot-lbl   { font-size:13pt; color:#0070d2; font-weight:bold; }

                .row-grand .tot-val   { font-size:13pt; color:#0070d2; font-weight:bold; border-bottom:none; }



                .payment-box   { margin-top:22pt; border:1pt solid #ccc; page-break-inside:avoid; }

                .payment-title { background-color:#0070d2; color:#fff; padding:6pt 8pt; text-align:center; font-weight:bold; text-transform:uppercase; font-size:9.5pt; }

                .payment-body  { padding:10pt 12pt; font-size:9pt; text-align:left; }



                .warranty-block   { margin-top:24pt; border-top:1.5pt solid #0070d2; padding-top:10pt; }

                .warranty-title   { font-weight:bold; font-size:11pt; margin-bottom:6pt; text-transform:uppercase; }

                .warranty-content { font-size:9.5pt; text-align:left; }

                .warranty-content img { max-width:100% !important; height:auto !important; }



                .sig-section  { margin-top:40pt; width:100%; page-break-inside:avoid; }

                .tbl-sig      { width:100%; border-collapse:collapse; }

                .tbl-sig td   { text-align:center; vertical-align:bottom; width:33.33%; padding:0 10pt; }

                .sig-space    { height:65pt; display:block; }

                .sig-line     { border-top:1pt solid #555; padding-top:4pt; font-size:8.5pt; margin:0 8pt; height:55pt; }

                .sig-stamp    { border:1pt solid #ccc; width:55pt; height:55pt; margin:0 auto 8pt auto; font-size:8pt; color:#bbb; line-height:55pt; }

                .tbl-payment { border-collapse: collapse; border: 1pt solid #0070d2; }
                .tbl-payment th, .tbl-payment td { border: 1pt solid #0070d2; }
            </style>

        </head>

        <body>

            <img src="{!$Resource.HeaderPDF}" class="header-img"/>

            <div class="page-counter">P&#225;g. <span class="pgNum"></span> de <span class="pgCount"></span></div>

            <img src="{!$Resource.Watermark}" class="watermark"/>

            <apex:outputPanel layout="block" styleClass="tech-draft-mark" rendered="{!esBorrador}">BORRADOR</apex:outputPanel>




            <!-- ═══ SECCIÓN 4: CONTRATO REPSE ════════════════════════════ -->

            <table style="width:100%; border-collapse:collapse; table-layout:fixed; -fs-table-paginate: paginate;">

                <thead>

                    <tr><td style="height:3.8cm; padding:0; line-height:0; font-size:0;">&#160;</td></tr>

                </thead>

                <tfoot>

                    <tr><td style="height:2.3cm; padding:0; line-height:0; font-size:0;">&#160;</td></tr>

                </tfoot>

                <tbody>
                    <!-- CARATULA (#11): encabezado igual al presupuesto, sin hoja aparte -->
                    <tr><td style="padding:0; vertical-align:top;"><div class="content-body">
                        <table class="hdr-table">
                            <tr>
                                <td width="62%" style="vertical-align:top; padding:0;">
                                    <div style="font-size:11pt; margin-top:4pt;">{!quoteRecord.Account.Razon_Social__c}</div>
                                    <div style="font-size:11pt; font-family:'Poppins','Helvetica','Arial',sans-serif; font-weight:bold; margin-top:2pt;">{!quoteRecord.Account.Name}</div>
                                    <div style="font-size:11pt; margin-top:2pt;">Atenci&#243;n:&#160;{!atencionNames}</div>
                                </td>
                                <td width="38%" style="vertical-align:top; text-align:right; font-size:10pt; padding:2pt 0 0 0;">
                                    <div><strong>Fecha:</strong>&#160;<apex:outputText value="{0,date,dd/MM/yyyy}"><apex:param value="{!quoteRecord.CreatedDate}"/></apex:outputText></div>
                                    <div><strong>Agente:</strong>&#160;{!quoteRecord.CreatedBy.Name}</div>
                                    <div style="font-size:11pt; font-family:'Poppins','Helvetica','Arial',sans-serif; font-weight:bold; margin-top:2pt;">Contrato No. {!numeroContrato}</div>
                                </td>
                            </tr>
                        </table>
                        <table class="hdr-table" style="margin:6pt 0 10pt 0; font-size:9pt;">
                            <tr><td width="28%" style="padding:2pt 0; vertical-align:top;"><strong>Direcci&#243;n:</strong></td><td style="padding:2pt 0;">{!direccionCliente}</td></tr>
                            <tr><td width="28%" style="padding:2pt 0; vertical-align:top;"><strong>Direcci&#243;n del servicio:</strong></td><td style="padding:2pt 0;">{!quoteRecord.Technical_Sedes__c}</td></tr>
                            <tr><td width="28%" style="padding:2pt 0; vertical-align:top;"><strong>C&#243;digo de lo contratado:</strong></td><td style="padding:2pt 0;"><apex:repeat value="{!selectedLineItems}" var="c"><apex:outputPanel rendered="{!NOT(ISBLANK(c.Product2.ProductCode))}" layout="block">{!c.Product2.ProductCode}</apex:outputPanel></apex:repeat></td></tr>
                        </table>
                    </div></td></tr>

                    <!-- CUERPO DEL CONTRATO = plantilla elegida en techContractManager (sin plantilla = no se imprime) -->
                    <apex:outputPanel rendered="{!NOT(ISBLANK(contenidoLegal))}" layout="none">
                    <tr><td style="padding:0; vertical-align:top;"><div class="content-body" style="font-size:9pt; line-height:1.6; text-align:left;"><div class="warranty-block"><apex:outputText escape="false" value="{!contenidoLegal}"/></div></div></td></tr>
                    </apex:outputPanel>

                    <tr><td style="padding:0; vertical-align:top;"><div class="content-body" style="font-size:9pt; line-height:1.6; text-align:left;">

                        <div class="sig-section" style="margin-top:50pt;">

                            <table class="tbl-sig">

                                <tr>

                                    <td>

                                        <div class="sig-space">

                                            <apex:outputPanel rendered="{!NOT(ISBLANK(signatureUrl))}" layout="none">

                                                <img src="{!signatureUrl}" style="height:55pt; width:auto;"/>

                                            </apex:outputPanel>

                                        </div>

                                        <div class="sig-line">

                                            <strong>&#8220;EL PRESTADOR&#8221;</strong><br/>

                                            PYATZ INGENIER&#205;A BIOTECNOL&#211;GICA S.A. DE C.V.<br/>

                                            {!firmanteNombre}<br/>

                                            REPRESENTANTE LEGAL

                                        </div>

                                    </td>

                                    <td>

                                        <div class="sig-space"></div>

                                        <div class="sig-line">

                                            <strong>&#8220;EL CLIENTE&#8221;</strong><br/>

                                            <strong>{!quoteRecord.Account.Name}</strong><br/>

                                            {!quoteRecord.Account.Nombre_RL__c}<br/>

                                            REPRESENTANTE LEGAL

                                        </div>

                                    </td>

                                    <td>

                                        <div class="sig-space" style="text-align:center;">

                                            <img src="{!$Resource.sello}" style="height:60pt; width:auto;"/>

                                        </div>

                                        <div class="sig-line">Sello de la Empresa</div>

                                    </td>

                                </tr>

                            </table>

                        </div>



                    </div></td></tr>

                </tbody>

            </table>



            <!-- 🔹🔹🔹 SECCIÓN 2, 2b y 3 UNIFICADAS: SERVICIOS, TOTALES Y FIRMAS 🔹🔹🔹 -->

            <div class="content-body" style="page-break-before:always;">

                <table class="tbl-svc" style="width:100%; border-collapse:collapse;">

                    <thead>

                        <tr><td colspan="{!dynamicColspan}" class="hdr-spacer" style="height:3.8cm; padding:0; line-height:0; font-size:0; border:none;">&#160;</td></tr>

                        </thead>

                      <tbody>

                          <!-- BLOQUE: ANEXO 1 (titulo + introduccion de la cotizacion) -->

                          <tr><td colspan="{!dynamicColspan}" style="padding:0 0 8pt 0; border:none;">

                              <p style="text-align:center; font-weight:bold; font-size:11pt;">ANEXO 1 / PRESUPUESTO</p>
                              <!-- Encabezado igual al de la cotizacion (QuoteTechnicalPDF) -->
                              <table class="hdr-table">
                                  <tr>
                                      <td width="62%" style="vertical-align:top; padding:0;">
                                          <div style="font-size:11pt; margin-top:4pt;">{!quoteRecord.Account.Razon_Social__c}</div>
                                          <div style="font-size:11pt; font-family:'Poppins','Helvetica','Arial',sans-serif; font-weight:bold; margin-top:2pt;">{!quoteRecord.Account.Name}</div>
                                          <div style="font-size:11pt; margin-top:2pt;">Atenci&#243;n:&#160;{!atencionNames}</div>
                                      </td>
                                      <td width="38%" style="vertical-align:top; text-align:right; font-size:10pt; padding:2pt 0 0 0;">
                                          <div><strong>Fecha:</strong>&#160;<apex:outputText value="{0,date,dd/MM/yyyy}"><apex:param value="{!quoteRecord.CreatedDate}"/></apex:outputText></div>
                                          <div><strong>Agente:</strong>&#160;{!quoteRecord.CreatedBy.Name}</div>
                                          <div style="font-size:11pt; font-family:'Poppins','Helvetica','Arial',sans-serif; font-weight:bold; margin-top:2pt;">Presupuesto No. {!quoteNumberShort}</div>
                                      </td>
                                  </tr>
                              </table>
                              <div style="margin-top:5pt; font-size:11pt; font-family:'Poppins','Helvetica','Arial',sans-serif; font-weight:bold; border-bottom:1pt solid #ddd; padding-bottom:4pt;">Asunto:&#160;{!quoteRecord.Name}</div>

                              <p>LIBERACI&#211;N DE PEDIDOS: <strong>{!BLANKVALUE(quoteRecord.Account.Proceso_liberacion_pedidos__c, '________________')}</strong></p>

                              <p>INGRESO DE FACTURAS: <strong>{!BLANKVALUE(quoteRecord.Account.Proceso_ingreso_de_facturas__c, '________________')}</strong></p>

                              <p>PLAZOS PARA REALIZAR LOS PAGOS DE LOS SERVICIOS: INDICADO EN LA TABLA DE IMPORTES.</p>


                              <apex:outputPanel rendered="{!NOT(ISBLANK(quoteRecord.Introduction_Text__c))}">

                                  <table style="width:100%; border-collapse:collapse; table-layout:fixed; margin-top:3pt; font-size:10pt;">

                                      <colgroup>

                                          <col style="width:15pt;"/>

                                          <col/>

                                          <col style="width:15pt;"/>

                                      </colgroup>

                                      <tr>

                                          <td style="width:15pt; border:none;"></td>

                                          <td style="border:none;">

                                              <apex:outputText value="{!quoteRecord.Introduction_Text__c}" escape="false"/>

                                          </td>

                                          <td style="width:15pt; border:none;"></td>

                                      </tr>

                                  </table>

                              </apex:outputPanel>

                          </td></tr>

                          <!-- BLOQUE: SERVICIOS -->

                          <apex:repeat value="{!selectedLineItems}" var="item">

                            <apex:outputPanel rendered="{!BLANKVALUE(item.Quantity, 0) == 0}" layout="none">

                                <tr class="row-sep">

                                    <td colspan="{!dynamicColspan}" style="padding:8pt;">{!item.Product2.Name}</td>

                                </tr>

                            </apex:outputPanel>

                            <apex:outputPanel rendered="{!BLANKVALUE(item.Quantity, 0) > 0}" layout="none">

                                <tr style="page-break-after:avoid;">

                                    <th style="text-align:center;">Concepto / Servicio</th>

                                    <th width="10%" style="text-align:center; display:{!IF(showQuantityCol, 'table-cell', 'none')};">Cant</th>

                                    <th width="20%" style="text-align:center; display:{!IF(showUnitPriceCol, 'table-cell', 'none')};">P. Unitario</th>

                                    <th width="20%" style="text-align:center; display:{!IF(showTotalPriceCol, 'table-cell', 'none')};">Importe</th>

                                </tr>

                                <tr class="row-item" style="page-break-inside:avoid;">

                                    <td style="text-align:center;"><strong>{!item.Product2.Name}</strong></td>

                                    <td style="text-align:center;"><apex:outputText value="{0, number, 0}"><apex:param value="{!item.Quantity}"/></apex:outputText></td>

                                    <apex:outputPanel rendered="{!config['show_line_prices']}" layout="none">

                                        <td style="text-align:center;"><apex:outputText value="{0, number, currency}"><apex:param value="{!BLANKVALUE(item.UnitPrice, 0)}"/></apex:outputText></td>

                                        <td style="text-align:center;"><strong><apex:outputText value="{0, number, currency}"><apex:param value="{!BLANKVALUE(item.TotalPrice, 0)}"/></apex:outputText></strong></td>

                                    </apex:outputPanel>

                                </tr>

                                <apex:outputPanel rendered="{!NOT(ISBLANK(item.Descripcion_Detallada__c))}" layout="none">

                                    <tr class="row-detail">

                                        <td colspan="{!dynamicColspan}">

                                            <div class="detail-inner">

                                                <apex:outputText value="{!item.Descripcion_Detallada__c}" escape="false"/>

                                            </div>

                                        </td>

                                    </tr>

                                </apex:outputPanel>

                            </apex:outputPanel>

                        </apex:repeat>

                    </tbody>

                    <tbody style="border-top:none;">

                        <!-- BLOQUE: TOTALES + CONDICIONES -->

                        <tr style="page-break-inside:avoid;"><td colspan="{!dynamicColspan}" style="padding-top:20pt;">

                            <apex:outputPanel rendered="{!config['show_total']}">

                                <table class="tbl-totals">

                                    <apex:outputPanel rendered="{!showSubtotal}" layout="none">

                                        <tr>

                                            <td class="tot-lbl">IMPORTE ORIGINAL</td>

                                            <td class="tot-val">

                                                <apex:outputText value="{0, number, currency}"><apex:param value="{!calcSubtotal1}"/></apex:outputText>

                                            </td>

                                        </tr>

                                    </apex:outputPanel>

                                    <apex:outputPanel rendered="{!AND(showDiscount, calcDescuento > 0)}" layout="none">

                                        <tr>

                                            <td class="tot-lbl" style="color:#d8000c;">DESCUENTO</td>

                                            <td class="tot-val" style="color:#d8000c;">

                                                - <apex:outputText value="{0, number, currency}"><apex:param value="{!calcDescuento}"/></apex:outputText>

                                            </td>

                                        </tr>

                                    </apex:outputPanel>

                                    <apex:outputPanel rendered="{!showSubtotal2}" layout="none">

                                        <tr>

                                            <td class="tot-lbl"><apex:outputText value="{!IF(calcDescuento > 0, 'SUBTOTAL CON DESC.', 'SUBTOTAL')}"/></td>

                                            <td class="tot-val">

                                                <apex:outputText value="{0, number, currency}"><apex:param value="{!calcSubtotal2}"/></apex:outputText>

                                            </td>

                                        </tr>

                                    </apex:outputPanel>

                                    <apex:outputPanel rendered="{!showTax}" layout="none">

                                        <tr>

                                            <td class="tot-lbl">I.V.A. (16%)</td>

                                            <td class="tot-val">

                                                <apex:outputText value="{0, number, currency}"><apex:param value="{!calcIva}"/></apex:outputText>

                                            </td>

                                        </tr>

                                    </apex:outputPanel>

                                    <apex:outputPanel rendered="{!showTotal}" layout="none">

                                        <tr class="row-grand">

                                            <td class="tot-lbl">TOTAL</td>

                                            <td class="tot-val">

                                                <apex:outputText value="{0, number, currency}"><apex:param value="{!calcTotal}"/></apex:outputText>

                                            </td>

                                        </tr>

                                    </apex:outputPanel>

                                </table>

                            </apex:outputPanel>



                            <!-- CONDICIONES DE PAGO -->

                            <apex:outputPanel rendered="{!NOT(ISBLANK(quoteRecord.Description))}">

                              <table class="tbl-payment" style="width:85%; margin: 15pt auto 20pt auto;">

                                  <thead>

                                      <tr><th colspan="3" style="text-align:center; font-size:10pt; background-color:#0070d2; color:#fff; border-bottom:none;">Datos de Pago</th></tr>

                                      <tr><th width="18%">M&#233;todo de Pago</th><th width="64%" style="text-align:center;">Descripci&#243;n</th><th width="18%">Tipo de Trabajo</th></tr>

                                  </thead>

                                  <tbody>

                                      <tr><td style="text-align:center; vertical-align:middle;">{!metodoPago}</td><td style="text-align:center; vertical-align:middle; font-size:8.5pt; line-height:1.15;"><apex:outputText value="{!descripcionPago}" escape="false"/></td><td style="text-align:center; vertical-align:middle;">{!tipoTrabajo}</td></tr>

                                  </tbody>

                              </table>

                          </apex:outputPanel>

                        </td></tr>



                        <!-- BLOQUE: GARANTÍA Y FIRMAS -->

                        <tr><td colspan="{!dynamicColspan}" style="padding-top:24pt;">

                            <div style="width:100%;">



                                <div class="sig-section">

                                    <table class="tbl-sig">

                                        <tr>

                                            <td>

                                                <div class="sig-space"></div>

                                                <div class="sig-line">Firma del CLIENTE</div>

                                            </td>

                                            <td>

                                                <div class="sig-space">

                                                    <apex:outputPanel rendered="{!NOT(ISBLANK(signatureUrl))}" layout="none">

                                                        <img src="{!signatureUrl}" style="height:55pt; width:auto;"/>

                                                    </apex:outputPanel>

                                                    <apex:outputPanel rendered="{!ISBLANK(signatureUrl)}" layout="none">

                                                        <div style="font-family:'Courier New',monospace; font-size:13pt; color:#0070d2;">{!firmanteNombre}</div>

                                                    </apex:outputPanel>

                                                </div>

                                                <div class="sig-line">FIRMA AUTORIZADA PYATZ</div>

                                            </td>

                                            <td>

                                                <div class="sig-space" style="text-align:center;">

                                                    <img src="{!$Resource.sello}" style="height:60pt; width:auto;"/>

                                                </div>

                                                <div class="sig-line">Sello de la Empresa</div>

                                            </td>

                                        </tr>

                                    </table>

                                </div>

                            </div>

                        </td></tr>



                    </tbody>

                    <tfoot><tr><td colspan="{!dynamicColspan}" style="height:2.3cm; padding:0; line-height:0; font-size:0; border:none;">&#160;</td></tr></tfoot>

                </table>

            </div>





            <img src="{!$Resource.FooterPDF}" class="footer-img"/>

        </body>

    </html>

</apex:page>